# Generate long random values for both secrets.
SD2API_API_KEY=replace-with-a-long-random-api-key
SD2API_ADMIN_KEY=replace-with-a-different-long-admin-key
NOVNC_PASSWORD=replace-with-a-vnc-password

SD2API_MODE=browser_pool
SD2API_DATABASE=/data/db/sd2api.db
SD2API_BROWSER_PROFILE=/data/profiles
SD2API_UPLOAD_DIR=/data/uploads
SD2API_UPLOAD_MAX_BYTES=209715200
SD2API_UPLOAD_IMAGE_MAX_BYTES=31457280
SD2API_UPLOAD_VIDEO_MAX_BYTES=209715200
SD2API_UPLOAD_AUDIO_MAX_BYTES=15728640

# Empty means use the Chromium bundled in the pinned Playwright image.
SD2API_BROWSER_CHANNEL=
SD2API_BROWSER_HEADLESS=false
SD2API_BROWSER_AUTOSTART=true
SD2API_BROWSER_MAX_WAIT=1800
SD2API_POOL_MAX_PENDING=500
SD2API_POOL_START_CONCURRENCY=3
SD2API_REQUEST_TIMEOUT=60

DISPLAY=:99
SCREEN_WIDTH=1280
SCREEN_HEIGHT=900
SCREEN_DEPTH=24
TZ=Asia/Shanghai
