# TikTok credentials must be copied manually from a successful Creative Studio
# request. Never commit the real values.
TIKTOK_COOKIE=

# Usually auto-detected from TIKTOK_COOKIE. Set only when the corresponding
# request header differs from the cookie value.
TIKTOK_CSRF_TOKEN=
TIKTOK_CREATIVE_CSRF_TOKEN=
TIKTOK_FP_ID=

TIKTOK_USER_AGENT=Mozilla/5.0
TIKTOK_BASE_URL=https://ads.tiktok.com

# Protect this adapter if anything other than localhost can reach it.
SD2API_API_KEY=change-me
SD2API_ADMIN_KEY=change-me-admin
SD2API_DATABASE=sd2api.db
SD2API_REQUEST_TIMEOUT=60

# direct: 使用上面的 Cookie 直接请求；browser: 驱动持久化浏览器 UI。
SD2API_MODE=direct
SD2API_BROWSER_PROFILE=.browser-profile
SD2API_BROWSER_CHANNEL=
SD2API_BROWSER_HEADLESS=false
SD2API_BROWSER_MAX_WAIT=1800
SD2API_BROWSER_AUTOSTART=false
SD2API_POOL_MAX_PENDING=500
SD2API_POOL_START_CONCURRENCY=3
SD2API_CREDENTIAL_KEY=
SD2API_AUTO_LOGIN=true
SD2API_AUTO_ACCEPT_TERMS=false
SD2API_LOGIN_TIMEOUT=600
SD2API_RELOGIN_INTERVAL=300
SD2API_TEMP_MAIL_BASE_URL=
SD2API_TEMP_MAIL_API_KEY=
SD2API_TEMP_MAIL_POLL_SECONDS=3
SD2API_TEMP_MAIL_TIMEOUT=180
SD2API_UPLOAD_DIR=uploads
SD2API_UPLOAD_MAX_BYTES=209715200
SD2API_UPLOAD_IMAGE_MAX_BYTES=31457280
SD2API_UPLOAD_VIDEO_MAX_BYTES=209715200
SD2API_UPLOAD_AUDIO_MAX_BYTES=15728640
SD2API_UPLOAD_MAX_PIXELS=40000000
